# HZN Bot Auto v3 - example configuration. Copy to .env (or point HZN_ENV_FILE to a
# file outside the repo, e.g. C:\Users\insan\HZN-Secrets\hzn.env) and fill locally.
# Full reference: docs/CONFIGURATION.md. Never commit real values.

# ---- mode ----
BOT_MODE=paper
# Live mode additionally requires this exact phrase (see docs/GO_LIVE_CHECKLIST.md):
LIVE_TRADING_CONFIRMATION=

# ---- Revolut X ----
REVOLUT_API_KEY=
REVOLUT_PRIVATE_KEY_PATH=C:\Users\insan\HZN-Secrets\RevolutX\private.pem
REVOLUT_REGION=EEA

# ---- capital (hard cap 10 USDC) ----
MAX_TRADING_BUDGET_QUOTE=10
SLOT_ALLOCATIONS=5,3,2
MAX_OPEN_POSITIONS=3

# ---- exits ----
STOP_LOSS_PCT=3
PLAN_SLOT1=2:1
PLAN_SLOT2=3:2
PLAN_SLOT3=3:2

# ---- risk ----
MAX_DAILY_LOSS_QUOTE=1.5
MAX_TRADES_PER_DAY=8
EMERGENCY_STOP=false

# ---- notifications / monitoring ----
DISCORD_WEBHOOK_URL=
HEALTH_PORT=8787
LOG_LEVEL=info
