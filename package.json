{
  "name": "hzn-bot-auto",
  "version": "3.0.0",
  "private": true,
  "description": "Early-momentum crypto trading bot for the Revolut X API (paper by default)",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/index.js",
    "status": "node src/cli/status.js",
    "stop": "node src/cli/control.js stop",
    "emergency-on": "node src/cli/control.js emergency-on",
    "emergency-off": "node src/cli/control.js emergency-off",
    "risk-reset": "node src/cli/control.js risk-reset",
    "research": "node tools/research.js",
    "reconcile": "node src/cli/reconcile.js",
    "adopt": "node src/cli/adopt.js",
    "resolve": "node src/cli/resolve.js",
    "fetch-history": "node tools/fetch-history.js",
    "fetch-binance": "node tools/fetch-binance-history.js",
    "replay": "node tools/replay.js",
    "account": "node tools/account-report.js",
    "check": "node tools/check-syntax.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "spreads": "node tools/spreads.js"
  },
  "dependencies": {}
}
